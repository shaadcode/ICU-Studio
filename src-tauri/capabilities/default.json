{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "dialog:default",
    "store:default",
    "fs:allow-stat",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-write-text-file",
    "fs:allow-create",
    "fs:allow-mkdir",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "opener:allow-open-path",
    "fs:allow-watch"
  ],
  "platforms": ["windows", "linux", "macOS"]
}
